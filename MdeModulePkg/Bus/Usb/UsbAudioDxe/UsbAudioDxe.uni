// /** @file
// USB Audio Class DXE driver - supports UAC 1.0 and UAC 2.0 devices.
//
// Consumes USB I/O Protocol and produces EFI_AUDIO_CODEC_PROTOCOL and EFI_AUDIO_OUTPUT_PROTOCOL,
